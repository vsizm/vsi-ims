# Populate Vercel separately for Development, Preview/Staging, and Production.
# Never commit actual values or reuse Production credentials outside Production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Temporary server-to-server guard only. This is not end-user authentication.
# The role is fixed by the deployment environment; callers cannot choose a human role.
VSI_INTERNAL_API_KEY=replace-with-a-long-unique-value
VSI_INTERNAL_API_ROLE=SYSTEM_ADMINISTRATOR

# Development: Neon development branch / synthetic data only
# Preview/Staging: Neon staging branch / acceptance-test data only
# Production: Neon production branch / live data only
