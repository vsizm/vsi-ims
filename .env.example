# Copy only the relevant values into Vercel's matching environment.
# Never commit actual values or reuse Production credentials outside Production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEXT_PUBLIC_APP_URL=http://localhost:3000

